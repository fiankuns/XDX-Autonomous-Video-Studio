{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fiankuns/XDX-Autonomous-Video-Studio/schemas/task_handoff.schema.json",
  "title": "XDX v4.0 Structured Agent Task Handoff Schema (18 Mandatory Contract Fields)",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "parent_task_id",
    "assigned_agent",
    "goal",
    "context",
    "input_artifacts",
    "input_artifact_hashes",
    "dependencies",
    "owned_artifacts",
    "allowed_tools",
    "forbidden_actions",
    "expected_output",
    "return_schema",
    "done_when",
    "required_evidence",
    "retry_budget",
    "status"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Za-z0-9_-]{3,48}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "parent_task_id": {
      "type": ["string", "null"],
      "pattern": "^TASK-[A-Za-z0-9_-]{3,48}$"
    },
    "assigned_agent": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,48}$"
    },
    "goal": {
      "type": "string",
      "minLength": 15
    },
    "context": {
      "type": "object",
      "required": ["project_state", "genre_ids", "reference_ids", "workspace_mode", "notes"],
      "properties": {
        "project_state": { "type": "string", "minLength": 2 },
        "genre_ids": { "type": "array", "items": { "type": "string" } },
        "reference_ids": { "type": "array", "items": { "type": "string" } },
        "workspace_mode": { "type": "string", "enum": ["inherit", "branch", "share"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "input_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "input_artifact_hashes": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^TASK-[A-Za-z0-9_-]{3,48}$"
      }
    },
    "owned_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    },
    "expected_output": {
      "type": "object",
      "required": ["summary", "output_artifacts", "output_format"],
      "properties": {
        "summary": { "type": "string", "minLength": 10 },
        "output_artifacts": { "type": "array", "items": { "type": "string" } },
        "output_format": { "type": "string", "enum": ["json", "markdown", "json_and_markdown", "binary_verified"] }
      },
      "additionalProperties": false
    },
    "return_schema": {
      "type": "string",
      "minLength": 3
    },
    "done_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "check_type", "target", "description"],
        "properties": {
          "criterion_id": { "type": "string", "pattern": "^DONE_[0-9]{2,}$" },
          "check_type": {
            "type": "string",
            "enum": [
              "file_exists_nonempty",
              "sha256_verified",
              "json_schema_valid",
              "pytest_pass",
              "no_unapproved_mutation",
              "independent_review_verdict"
            ]
          },
          "target": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 10 }
        },
        "additionalProperties": false
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "retry_budget": {
      "type": "object",
      "required": ["max_attempts", "attempts_used", "timeout_seconds"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "attempts_used": { "type": "integer", "minimum": 0, "maximum": 5 },
        "timeout_seconds": { "type": "integer", "minimum": 5, "maximum": 3600 }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "READY",
        "RUNNING",
        "WAITING_REVIEW",
        "REVISION_REQUIRED",
        "COMPLETED",
        "BLOCKED",
        "FAILED",
        "CANCELLED"
      ]
    }
  },
  "additionalProperties": false
}
