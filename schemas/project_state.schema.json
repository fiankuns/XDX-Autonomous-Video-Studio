{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fiankuns/XDX-Autonomous-Video-Studio/schemas/project_state.schema.json",
  "title": "XDX Project State Machine v3.4",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "project_title",
    "current_state",
    "package_version",
    "genres",
    "timeline_spec",
    "approval_status",
    "history",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["3.3.0", "3.4.0"] },
    "project_id": { "type": "string", "minLength": 3 },
    "project_title": { "type": "string", "minLength": 3 },
    "mode": {
      "type": "string",
      "enum": [
        "cari_topik",
        "topik",
        "buat_otomatis",
        "analisis_referensi",
        "remake_gaya",
        "lanjutkan",
        "revisi"
      ]
    },
    "current_state": {
      "type": "string",
      "enum": [
        "INIT",
        "REFERENCE_REVIEW",
        "TOPIC_RESEARCH",
        "BLUEPRINT",
        "PREPRODUCTION",
        "WAITING_APPROVAL",
        "APPROVED",
        "MCP_PREFLIGHT",
        "ASSET_PROCUREMENT",
        "STYLE_FRAME",
        "ANIMATIC",
        "SHOT_RENDER",
        "COMPOSITE",
        "QC",
        "SELF_CORRECTION",
        "DELIVERED",
        "BLOCKED"
      ]
    },
    "package_version": { "type": "string", "pattern": "^v[0-9]+(\\.[0-9]+)*$" },
    "package_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "genres": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "explainer",
          "edukasi",
          "sejarah",
          "biografi",
          "dokumenter",
          "storytelling",
          "horor",
          "komedi_absurd"
        ]
      }
    },
    "timeline_spec": {
      "type": "object",
      "required": ["fps", "width", "height", "aspect_ratio", "total_frames"],
      "properties": {
        "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
        "width": { "type": "integer", "minimum": 128 },
        "height": { "type": "integer", "minimum": 128 },
        "aspect_ratio": { "type": "string" },
        "total_frames": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "approval_status": {
      "type": "object",
      "required": ["approved", "approved_digest", "approved_version", "explicit_user_message"],
      "properties": {
        "approved": { "type": "boolean" },
        "approval_id": { "type": ["string", "null"] },
        "actor_role": { "type": ["string", "null"] },
        "approved_digest": { "type": ["string", "null"] },
        "approved_version": { "type": ["string", "null"] },
        "approved_scopes": { "type": "array", "items": { "type": "string" } },
        "explicit_user_message": { "type": ["string", "null"] },
        "recorded_at": { "type": ["string", "null"] },
        "expires_at": { "type": ["string", "null"] },
        "revoked": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "blocked_reason": { "type": ["string", "null"] },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_state", "to_state", "timestamp", "reason"],
        "properties": {
          "from_state": { "type": ["string", "null"] },
          "to_state": { "type": "string" },
          "timestamp": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
