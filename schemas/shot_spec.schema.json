{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XDX shot spec (single authoring file: action events + callouts per shot)",
  "type": "object",
  "required": ["schema", "project_id", "shots"],
  "properties": {
    "schema": {"const": "xdx.shot-spec.v1"},
    "project_id": {"type": "string"},
    "note": {"type": "string"},
    "shots": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["shot_id"],
      "properties": {
        "shot_id": {"type": "string"},
        "events": {"type": "array", "items": {"type": "object", "required": ["event_id", "action", "window", "constraints"]}},
        "callouts": {"type": "array", "items": {
          "type": "object", "required": ["id", "text", "kind", "anchor", "offset", "show"],
          "properties": {
            "id": {"type": "string"}, "text": {"type": "string"}, "kind": {"enum": ["warm", "cool"]},
            "anchor": {"type": "object", "required": ["space"], "properties": {"space": {"enum": ["world", "ac", "od", "named"]}, "p": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "name": {"type": "string"}}},
            "offset": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
            "show": {"type": "object", "required": ["in"], "properties": {"in": {"$ref": "#/definitions/win"}, "out": {"$ref": "#/definitions/win"}}}
          }}}
      }}}
  },
  "definitions": {
    "bound": {"anyOf": [{"type": "number"}, {"type": "object", "required": ["frac"], "properties": {"frac": {"type": "number"}, "plus": {"type": "number"}}}]},
    "win": {"type": "object", "required": ["cue", "from", "to"], "properties": {"cue": {"type": "integer", "minimum": 0}, "from": {"$ref": "#/definitions/bound"}, "to": {"$ref": "#/definitions/bound"}}}
  }
}
