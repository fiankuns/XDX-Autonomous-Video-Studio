{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fiankuns/XDX-Autonomous-Video-Studio/schemas/asset_registry.schema.json",
  "title": "XDX Intelligent Asset Registry Schema v3.3",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "style_bible_default",
    "assets"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "3.3.0" },
    "updated_at": { "type": "string" },
    "style_bible_default": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "name",
          "category",
          "origin_type",
          "source_provider",
          "source_url",
          "license_spdx",
          "attribution_required",
          "commercial_allowed",
          "formats",
          "unit_scale_m",
          "up_axis",
          "compatible_engines",
          "style_harmonized",
          "qc_status"
        ],
        "properties": {
          "asset_id": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
          "name": { "type": "string", "minLength": 2 },
          "category": {
            "type": "string",
            "enum": [
              "character_rig",
              "environment_modular",
              "prop_3d",
              "pbr_material",
              "hdri_lighting",
              "font_typography",
              "motion_graphic",
              "audio_sfx"
            ]
          },
          "origin_type": {
            "type": "string",
            "enum": ["curated_registry", "external_downloaded", "procedural_generated"]
          },
          "source_provider": { "type": "string", "minLength": 2 },
          "source_url": { "type": "string", "minLength": 4 },
          "license_spdx": { "type": "string", "minLength": 2 },
          "attribution_required": { "type": "boolean" },
          "attribution_text": { "type": ["string", "null"] },
          "commercial_allowed": { "type": "boolean" },
          "formats": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "unit_scale_m": { "type": "number", "exclusiveMinimum": 0 },
          "up_axis": { "type": "string", "enum": ["+Y", "+Z", "N/A"] },
          "polycount_budget": { "type": ["integer", "null"], "minimum": 0 },
          "compatible_engines": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["blender", "threejs", "remotion", "ffmpeg"] }
          },
          "style_harmonized": { "type": "boolean" },
          "style_profile": { "type": "object" },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "cache_key": { "type": ["string", "null"] },
          "qc_status": {
            "type": "string",
            "enum": ["tested", "verified_metadata", "procedural_ready", "failed", "not_tested"]
          },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
