{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fiankuns/XDX-Autonomous-Video-Studio/schemas/review_report.schema.json",
  "title": "XDX v4.0 Independent Verification Report Schema (Phase 01.6B/01.6C Hardened)",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "project_id",
    "verifier_agent",
    "reviewed_task_id",
    "producer_agent",
    "verdict",
    "invocation_receipt",
    "reviewed_artifact_hashes",
    "required_criteria_ids",
    "checked_criteria",
    "defects"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["4.0.0-phase01.6b", "4.0.0-phase01.6c"]
    },
    "review_id": {
      "type": "string",
      "pattern": "^REV-[A-Za-z0-9_-]{3,48}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "verifier_agent": {
      "type": "string",
      "enum": [
        "preproduction_verifier",
        "visual_critic",
        "technical_auditor",
        "success_auditor"
      ]
    },
    "reviewer_task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Za-z0-9_-]{3,48}$"
    },
    "reviewed_task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Za-z0-9_-]{3,48}$"
    },
    "additional_reviewed_task_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^TASK-[A-Za-z0-9_-]{3,48}$"
      }
    },
    "producer_agent": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,48}$"
    },
    "producer_conversation_id": {
      "type": ["string", "null"]
    },
    "reviewer_conversation_id": {
      "type": ["string", "null"]
    },
    "criteria_manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "REVISION_REQUIRED", "BLOCKED"]
    },
    "invocation_receipt": {
      "type": "object",
      "required": [
        "invocation_id",
        "agent_id",
        "runtime_name",
        "execution_mode",
        "actually_invoked",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "invocation_id": { "type": "string", "minLength": 4 },
        "agent_id": { "type": "string", "minLength": 3 },
        "runtime_name": { "type": "string", "enum": ["antigravity", "codex", "python_local_test", "python_standalone"] },
        "execution_mode": {
          "type": "string",
          "enum": [
            "native_subagent",
            "recorded_workflow_replay",
            "sequential_fallback_honest",
            "mock_execution"
          ]
        },
        "actually_invoked": { "type": "boolean", "const": true },
        "conversation_id": { "type": ["string", "null"] },
        "known_model_routing": { "type": "string" },
        "started_at": { "type": "string", "minLength": 10 },
        "completed_at": { "type": "string", "minLength": 10 }
      },
      "additionalProperties": true
    },
    "reviewed_artifact_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "pre_review_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "post_review_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "reviewed_artifact_manifest": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "required": ["sha256"],
        "properties": {
          "owner_task_id": { "type": "string" },
          "owner_agent": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      }
    },
    "required_criteria_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "checked_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "status", "evidence"],
        "properties": {
          "criterion_id": { "type": "string", "minLength": 3 },
          "status": { "type": "string", "enum": ["PASS", "FAIL"] },
          "evidence": { "type": "string", "minLength": 15 },
          "inspected_artifacts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "defect_id",
          "location",
          "severity",
          "expected_result",
          "observed_result",
          "evidence",
          "responsible_agent"
        ],
        "properties": {
          "defect_id": { "type": "string", "minLength": 3 },
          "criterion_id": { "type": "string", "minLength": 3 },
          "location": { "type": "string", "minLength": 1 },
          "artifact": { "type": "string", "minLength": 1 },
          "clause_or_shot_id": { "type": ["string", "null"] },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "expected_result": { "type": "string", "minLength": 5 },
          "observed_result": { "type": "string", "minLength": 5 },
          "evidence": { "type": "string", "minLength": 5 },
          "responsible_agent": { "type": "string", "minLength": 3 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "4.0.0-phase01.6c" } }
      },
      "then": {
        "required": [
          "reviewer_task_id",
          "producer_conversation_id",
          "reviewer_conversation_id",
          "criteria_manifest_digest",
          "reviewed_artifact_manifest",
          "pre_review_hashes",
          "post_review_hashes"
        ]
      }
    }
  ],
  "additionalProperties": false
}
