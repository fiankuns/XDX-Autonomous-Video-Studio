{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fiankuns/XDX-Autonomous-Video-Studio/schemas/preset_library.schema.json",
  "title": "XDX Reusable Production Preset Library Schema v3.3",
  "type": "object",
  "required": [
    "schema_version",
    "library_id",
    "library_name",
    "category",
    "version",
    "description",
    "presets"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "3.3.0" },
    "library_id": { "type": "string", "minLength": 3 },
    "library_name": { "type": "string", "minLength": 3 },
    "category": { "type": "string", "minLength": 2 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "minLength": 5 },
    "presets": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "parameters",
          "version",
          "source",
          "license",
          "engine_compatibility",
          "test_status"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
          "name": { "type": "string", "minLength": 2 },
          "description": { "type": "string" },
          "parameters": { "type": "object", "minProperties": 1 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "source": { "type": "string", "minLength": 2 },
          "license": { "type": "string", "minLength": 2 },
          "engine_compatibility": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["blender", "threejs", "remotion", "rea_video", "ffmpeg"]
            }
          },
          "test_status": {
            "type": "string",
            "enum": ["tested", "not_tested", "failed", "specification_only"]
          },
          "genres": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
