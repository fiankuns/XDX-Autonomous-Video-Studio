  "vo_segments": [
    {
      "segment_id": "VO_001",
      "beat_id": "B01",
      "shot_id": "S001",
      "shot_ids": [
        "S001",
        "S002",
        "S003",
        "S004"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Kamu cuma niat mengurus satu surat keterangan domisili lima menit, tapi pulang memeluk bundel berkas setebal bantal.",
      "word_count": 17,
      "start_time_s": 0.0,
      "end_time_s": 10.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Akrab menyapa dengan kata 'Kamu', nada santai penuh senyum miring khas pengamatan sehari-hari.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_002",
      "beat_id": "B02",
      "shot_id": "S005",
      "shot_ids": [
        "S005",
        "S006",
        "S007",
        "S008"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Begitu map tipis disodorkan ke loket, muncul aturan klasik birokrasi: satu surat utama ternyata membutuhkan banyak surat pengantar lain terlebih dahulu.",
      "word_count": 21,
      "start_time_s": 10.0,
      "end_time_s": 23.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Tenang dan jernih saat menekankan frasa 'satu surat utama ternyata membutuhkan banyak surat pengantar lain'.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_003",
      "beat_id": "B03",
      "shot_id": "S009",
      "shot_ids": [
        "S009",
        "S010",
        "S011",
        "S012"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Damar bolak-balik fotokopi kartu identitas yang datanya sudah tercetak jelas di layar komputer, lengkap dengan map merah, kuning, dan hijau sesuai hari.",
      "word_count": 22,
      "start_time_s": 23.0,
      "end_time_s": 37.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Ritme sedikit meningkat menggambarkan kepanikan sopan bolak-balik mesin fotokopi.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_004",
      "beat_id": "B04",
      "shot_id": "S013",
      "shot_ids": [
        "S013",
        "S014",
        "S015",
        "S016"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Riset pelayanan publik menyebutnya beban administrasi berulang: waktu warga habis mengantar kertas dari meja kanan ke meja sebelahnya yang berjarak satu meter.",
      "word_count": 22,
      "start_time_s": 37.0,
      "end_time_s": 50.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Nada dokumenter serius yang kontras lucu dengan aksi bergeser satu meter di layar.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_005",
      "beat_id": "B05",
      "shot_id": "S017",
      "shot_ids": [
        "S017",
        "S018",
        "S019",
        "S020"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Akhirnya satu surat impian itu terbit sore hari, tepat setelah masa berlaku surat pengantar pertamanya habis tadi siang.",
      "word_count": 18,
      "start_time_s": 50.0,
      "end_time_s": 60.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Jeda komedi sepersekian detik sebelum kalimat 'tepat setelah masa berlaku surat pengantar pertamanya habis tadi siang'.",
      "breath_pause_ms": 220
    }
  ],
  "dialogue_lines": [
    {
      "beat_id": "B01",
      "shot_id": "S002",
      "timing_status": "ESTIMATED",
      "speaker_id": "char_damar_pemohon",
      "line": "Pagi Bu, mau mengurus satu surat ini saja.",
      "delivery": "ceria dan penuh keyakinan pagi hari",
      "onscreen_speaking": true
    },
    {
      "beat_id": "B02",
      "shot_id": "S006",
      "timing_status": "ESTIMATED",
      "speaker_id": "char_bu_rantih_loket",
      "line": "Kurang surat pengantar RT untuk mengambil formulir pengantar RW, Mas.",
      "delivery": "datar sopan tanpa berkedip sambil menunjuk papan syarat",
      "onscreen_speaking": true
    },
    {
      "beat_id": "B03",
      "shot_id": "S010",
      "timing_status": "ESTIMATED",
      "speaker_id": "char_damar_pemohon",
      "line": "Ini fotokopi KTP untuk membuktikan KTP asli saya benar KTP?",
      "delivery": "bingung sopan sambil menahan tumpukan map dengan dagu",
      "onscreen_speaking": true
    },
    {
      "beat_id": "B04",
      "shot_id": "S014",
      "timing_status": "ESTIMATED",
      "speaker_id": "char_bu_rantih_loket",
      "line": "Nah, tinggal stempel pengantar untuk melegalisir surat pengantarnya.",
      "delivery": "tenang meyakinkan sambil mengangkat stempel kayu paling besar",
      "onscreen_speaking": true
    },
    {
      "beat_id": "B05",
      "shot_id": "S018",
      "timing_status": "ESTIMATED",
      "speaker_id": "char_damar_pemohon",
      "line": "Berarti besok mulai dari map biru tipis lagi?",
      "delivery": "senyum pasrah lirih sambil menatap jam dinding",
      "onscreen_speaking": true
    }
  ],
