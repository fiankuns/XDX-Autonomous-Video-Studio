  "vo_segments": [
    {
      "segment_id": "VO_001",
      "beat_id": "B01",
      "shot_id": "S001",
      "shot_ids": [
        "S001",
        "S002",
        "S003",
        "S004",
        "S005",
        "S006"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Detik ini juga, cabut sumbat raksasa Bumi dan kuras habis seluruh samudra dalam sekejap mata. Perahu kayu Pak Teguh tidak tenggelam, melainkan mendarat mulus di hamparan lumpur asin tanpa setetes ombak pun.",
      "word_count": 32,
      "start_time_s": 0.0,
      "end_time_s": 16.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Tegas dan memikat di kalimat pembuka tiga detik pertama, lalu bergeser ke nada bercerita ringan yang jenaka.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_002",
      "beat_id": "B02",
      "shot_id": "S007",
      "shot_ids": [
        "S007",
        "S008",
        "S009",
        "S010",
        "S011",
        "S012"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Apa yang sebenarnya terjadi jika seluruh laut Bumi menghilang? Kita baru saja melenyapkan satu koma tiga ratus tiga puluh dua miliar kilometer kubik air asin, atau sekitar sembilan puluh tujuh persen cadangan air planet ini.",
      "word_count": 35,
      "start_time_s": 16.0,
      "end_time_s": 34.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Jernih dan terukur dengan penekanan pada angka volume 1,332 miliar kilometer kubik dan rasio 97 persen.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_003",
      "beat_id": "B03",
      "shot_id": "S013",
      "shot_ids": [
        "S013",
        "S014",
        "S015",
        "S016",
        "S017",
        "S018"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Begitu air surut, tepi pantai berubah menjadi jurang landas kontinen setinggi gedung pencakar langit. Kapal kargo yang tadinya mengapung kini bertengger di bibir tebing curam sedalam empat kilometer menuju dataran abisal yang gelap dan berdebu.",
      "word_count": 35,
      "start_time_s": 34.0,
      "end_time_s": 54.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Bernada takjub menggambarkan ketinggian tebing empat kilometer, memberi jeda pendek sebelum dialog komedi Pak Teguh.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_004",
      "beat_id": "B04",
      "shot_id": "S019",
      "shot_ids": [
        "S019",
        "S020",
        "S021",
        "S022",
        "S023",
        "S024"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Di dasar Pasifik, menganga Palung Mariana sedalam hampir sebelas kilometer, lebih tinggi dari Gunung Everest jika dibalik. Sementara di tengah samudra, punggungan gunung api bawah laut sepanjang enam puluh lima ribu kilometer langsung menyemburkan asap belerang ke udara terbuka.",
      "word_count": 39,
      "start_time_s": 54.0,
      "end_time_s": 72.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Dramatis dan berwibawa layaknya dokumenter ekspedisi kebumian saat menyebut Palung Mariana dan punggungan tengah samudra.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_005",
      "beat_id": "B05",
      "shot_id": "S025",
      "shot_ids": [
        "S025",
        "S026",
        "S027",
        "S028",
        "S029",
        "S030"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Bencana sesungguhnya justru dimulai di langit. Lebih dari delapan puluh lima persen uap air pembentuk awan berasal dari penguapan laut. Tanpa samudra, pabrik hujan global tutup total, awan memudar dalam hitungan hari, dan sungai besar mengering.",
      "word_count": 36,
      "start_time_s": 72.0,
      "end_time_s": 92.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Mengalir cepat namun jernih untuk menghubungkan sebab-akibat dari hilangnya penguapan laut ke berhentinya hujan daratan.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_006",
      "beat_id": "B06",
      "shot_id": "S031",
      "shot_ids": [
        "S031",
        "S032",
        "S033",
        "S034",
        "S035",
        "S036"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Samudra juga bekerja sebagai penyangga panas raksasa yang menyerap sembilan puluh persen kelebihan kalor Bumi dan membagikannya lewat arus termal. Tanpa selimut air ini, siang hari memanggang benua secara ekstrem, sedangkan malam hari anjlok membeku seperti gurun.",
      "word_count": 37,
      "start_time_s": 92.0,
      "end_time_s": 112.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Kontraskan intonasi panas menyengat pada bagian siang hari dengan penurunan nada dingin tajam pada bagian malam hari.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_007",
      "beat_id": "B07",
      "shot_id": "S037",
      "shot_ids": [
        "S037",
        "S038",
        "S039",
        "S040",
        "S041",
        "S042"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Di lapisan permukaan yang lenyap tadi, miliaran fitoplankton mikroskopis tadinya memproduksi sekitar separuh oksigen Bumi sekaligus mengunci karbon dioksida. Saat hamparan lumpur organik di dasar laut mengering dan membusuk, gas karbon terlepas deras ke atmosfer.",
      "word_count": 35,
      "start_time_s": 112.0,
      "end_time_s": 130.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Jelas saat menjelaskan peran mikroskopis fitoplankton, lalu beri ruang komedi singkat untuk reaksi Pak Teguh.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_008",
      "beat_id": "B08",
      "shot_id": "S043",
      "shot_ids": [
        "S043",
        "S044",
        "S045",
        "S046",
        "S047",
        "S048"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Mari urutkan garis waktunya. Hari pertama, pelabuhan lumpuh dan badai debu garam menyapu pesisir. Bulan pertama, gagal panen melanda seluruh benua karena hujan berhenti. Dalam hitungan dekade, hutan hujan mengering dan memicu kebakaran lintas benua.",
      "word_count": 35,
      "start_time_s": 130.0,
      "end_time_s": 148.0,
      "timing_status": "ESTIMATED",
