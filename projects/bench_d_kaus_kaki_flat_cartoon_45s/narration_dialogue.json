      "onscreen_speaking": true
    },
    {
      "beat_id": "B02",
      "shot_id": "S004",
      "timing_status": "ESTIMATED",
      "speaker_id": "char_detektif_kaus",
      "line": "Sst, di balik karet ini hangat sekali.",
      "delivery": "bisikan jenaka menggemaskan dari balik lipatan karet",
      "onscreen_speaking": true
    },
    {
      "beat_id": "B03",
      "shot_id": "S008",
      "timing_status": "ESTIMATED",
      "speaker_id": "char_kino_pencuci",
      "line": "Ketahuan kau bersembunyi di celana olahraga!",
      "delivery": "girang penuh kemenangan sambil mengguncang pipa celana panjang",
      "onscreen_speaking": true
    },
    {
      "beat_id": "B04",
      "shot_id": "S012",
      "timing_status": "ESTIMATED",
      "speaker_id": "char_kino_pencuci",
      "line": "Mulai besok, belang kuning resmi berjodoh dengan polkadot biru.",
      "delivery": "percaya diri sambil bertolak pinggang memamerkan kedua pergelangan kaki",
