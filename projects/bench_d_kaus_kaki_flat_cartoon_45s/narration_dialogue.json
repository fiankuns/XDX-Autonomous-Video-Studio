      "shot_ids": [
        "S001",
        "S002"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Tujuh pasang kaus kaki masuk ke mesin cuci malam ini tetapi saat pintu dibuka, hanya tiga belas helai yang keluar hidup-hidup.",
      "word_count": 21,
      "start_time_s": 0.0,
      "end_time_s": 10.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Berbisik dramatis ala narator kisah misteri malam hari namun dengan ujung kalimat ringan yang mengundang senyum.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_002",
      "beat_id": "B02",
      "shot_id": "S003",
      "shot_ids": [
        "S003",
        "S004",
        "S005",
        "S006"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Lampu ruang cuci berkedip pelan. Bukan ulah hantu binatu, melainkan lipatan karet pintu mesin cuci yang diam-diam menelan kaus kaki kecil saat tabung berputar kencang.",
      "word_count": 25,
      "start_time_s": 10.0,
      "end_time_s": 23.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Mulai dengan ketegangan misteri pelan, lalu berubah ceria dan terang saat mengungkap mekanisme lipatan karet pintu.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_003",
      "beat_id": "B03",
      "shot_id": "S007",
      "shot_ids": [
        "S007",
        "S008",
        "S009",
        "S010"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Sisanya bersembunyi di ujung pipa celana panjang karena mata kita lengah oleh perhatian selektif waktu menyortir tumpukan cucian.",
      "word_count": 18,
      "start_time_s": 23.0,
      "end_time_s": 35.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Lincah, cepat, dan penuh senyum saat membongkar trik persembunyian kedua di tumpukan pakaian.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_004",
      "beat_id": "B04",
      "shot_id": "S011",
      "shot_ids": [
        "S011",
        "S012"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Misteri terpecahkan tanpa drama mistis, meski laci kos tetap penuh kaus kaki jomblo aneka motif.",
      "word_count": 15,
      "start_time_s": 35.0,
      "end_time_s": 45.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Ceria, hangat, dan santai menutup cerita dengan nada kemenangan komedi.",
      "breath_pause_ms": 220
    }
  ],
  "dialogue_lines": [
    {
      "beat_id": "B01",
