  "vo_segments": [
    {
      "segment_id": "VO_001",
      "beat_id": "B01",
      "shot_id": "S001",
      "shot_ids": [
        "S001",
        "S002",
        "S003",
        "S004"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Pernah heran bagaimana AC mendinginkan ruangan pengap tanpa memasukkan udara dari luar? Rahasianya: AC bukan pembuat dingin, melainkan pemindah panas kamar.",
      "word_count": 21,
      "start_time_s": 0.0,
      "end_time_s": 10.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Hangat, penasaran, ritme pembuka tegas dengan jeda pendek setelah kata 'Rahasianya'.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_002",
      "beat_id": "B02",
      "shot_id": "S005",
      "shot_ids": [
        "S005",
        "S006",
        "S007",
        "S008"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Udara hangat ruangan ditarik kipas melewati kisi evaporator yang sangat dingin. Di dalam pipanya, cairan refrigeran menyerap kalor udara lalu mendidih menjadi uap bertekanan rendah.",
      "word_count": 25,
      "start_time_s": 10.0,
      "end_time_s": 23.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Jernih dan artikulatif saat menyebutkan istilah 'evaporator' dan 'refrigeran'.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_003",
      "beat_id": "B03",
      "shot_id": "S009",
      "shot_ids": [
        "S009",
        "S010",
        "S011",
        "S012"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Uap pembawa panas itu mengalir ke unit luar menuju kompresor. Kompresor memampatkannya hingga bersuhu tinggi, supaya sirip kondensor mudah membuang panasnya ke udara luar.",
      "word_count": 24,
      "start_time_s": 23.0,
      "end_time_s": 37.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Dinamis mengikuti lonjakan tekanan di kompresor lalu mengalir mantap saat pelepasan panas kondensor.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_004",
      "beat_id": "B04",
      "shot_id": "S013",
      "shot_ids": [
        "S013",
        "S014",
        "S015",
        "S016"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Setelah mengembun kembali jadi cairan, refrigeran dipaksa melewati celah sempit katup ekspansi. Tekanannya anjlok, suhunya langsung membeku lagi, sambil mengembunkan uap air lembap ruangan.",
      "word_count": 24,
      "start_time_s": 37.0,
      "end_time_s": 50.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Berikan aksen kontras tajam pada kalimat 'Tekanannya anjlok, suhunya langsung membeku lagi'.",
      "breath_pause_ms": 220
    },
    {
      "segment_id": "VO_005",
      "beat_id": "B05",
      "shot_id": "S017",
      "shot_ids": [
        "S017",
        "S018",
        "S019",
        "S020"
      ],
      "speaker": "narrator_id_offscreen",
      "text": "Jadi tak perlu menekan remot ke enam belas derajat agar cepat sejuk. Setel dua puluh empat derajat saja, biarkan siklus pemindah panas bekerja hemat!",
      "word_count": 24,
      "start_time_s": 50.0,
      "end_time_s": 60.0,
      "timing_status": "ESTIMATED",
      "voice_direction": "Bersahabat, meyakinkan, dan menutup dengan nada segar penuh solusi praktis.",
      "breath_pause_ms": 220
    }
  ],
  "dialogue_lines": [
    {
      "beat_id": "B01",
      "shot_id": "S002",
      "timing_status": "ESTIMATED",
      "speaker_id": "char_bima_penghuni",
      "line": "Pantas lubang anginnya rapat semua!",
      "delivery": "terkejut polos sambil menunjuk kusen jendela",
      "onscreen_speaking": true
    },
    {
      "beat_id": "B03",
      "shot_id": "S010",
      "timing_status": "ESTIMATED",
      "speaker_id": "char_nadia_presenter",
      "line": "Makanya angin unit luar selalu terasa gerah.",
      "delivery": "tersenyum sambil menunjuk kipas kondensor luar",
      "onscreen_speaking": true
    },
    {
      "beat_id": "B05",
      "shot_id": "S018",
      "timing_status": "ESTIMATED",
      "speaker_id": "char_bima_penghuni",
      "line": "Dompet aman, kamar tetap adem!",
      "delivery": "lega jenaka sambil mengacungkan jempol",
      "onscreen_speaking": true
    }
  ],
