        "mono_font": "JetBrains Mono",
        "heading_tracking_em": -0.02,
        "line_height": 1.2
      },
      "version": "1.0.0",
      "source": "Google Fonts Catalog",
      "license": "OFL-1.1",
      "engine_compatibility": [
        "remotion",
        "threejs",
        "blender",
        "ffmpeg"
      ],
      "test_status": "UNIT_TESTED",
      "executor_binding": "PresetExecutorEngine.evaluate_kinetic_typography"
    },
    {
      "id": "typo_historical_archival_serif",
      "name": "Merriweather + Inter (History & Biography)",
      "parameters": {
        "heading_font": "Merriweather",
        "body_font": "Inter",
        "mono_font": "JetBrains Mono",
