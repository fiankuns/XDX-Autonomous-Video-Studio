    "default_language": "id-ID",
    "pipeline_chain": [
      "ORCHESTRATOR",
      "SPECIALIST_AGENTS",
      "INDEPENDENT_VERIFIER",
      "HUMAN_APPROVAL",
      "PRODUCTION",
      "ACTUAL_RENDER",
      "VISUAL_CRITIC",
      "SUCCESS_AUDITOR"
    ]
  },
  "concurrency_and_budget": {
    "recommended_active_specialists_min": 3,
    "recommended_active_specialists_max": 6,
    "hard_max_active_specialists": 6,
    "max_blender_scene_mutating_workers": 1,
    "default_task_timeout_seconds": 300,
    "default_max_retries_per_task": 3,
    "self_correction_max_iterations_per_defect": 3
  },
  "model_routing_policy": {
    "antigravity_session_orchestrator": {
      "preferred_planner_model": "Gemini 4 Neon",
      "enterprise_fallback_planner_model": "Gemini 4 Carbon",
      "preferred_executor_model": "Gemini 4 Hydrogen",
      "cross_family_reviewer_when_supported": "Claude Sonnet 5.5 / Claude Opus 5.5",
      "note": "Configured by the user via Antigravity Model Selector ('Orchestrator'); never fabricated in Python if unavailable on the active account tier."
    },
    "programmatic_subagent_invocation": {
      "supported_tool_enum": ["inherit", "flash_lite", "flash", "pro"],
      "default_model_argument": "inherit",
      "policy": "Always pass Model='inherit' to invoke_subagent unless the user explicitly instructs switching to 'pro' or 'flash'."
    },
    "execution_modes": {
      "single_agent": "Focused single-file edits, quick inspections, and deterministic validations.",
      "subagents": "Specialized role delegation and fresh-context independent verification.",
      "swarm": "Broad tasks cleanly partitioned across independent files/packages with a @verifier.",
      "boost": "Hard algorithmic, concurrency, or multi-round debugging challenges.",
      "teamwork": "Long-horizon multi-milestone engineering with Critic/Challenger/Auditor/Success Auditor gates."
    }
  },
  "separation_of_duties": {
    "master_director_can_be_sole_reviewer": false,
    "master_director_can_set_approved_directly": false,
    "master_director_can_set_completed_directly": false,
    "verifier_can_mutate_producer_artifacts": false,
    "success_auditor_requires_render_and_visual_evidence_for_production_pass": true
