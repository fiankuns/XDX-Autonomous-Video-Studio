# Python bytecode & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node dependencies & build caches (never commit node_modules)
node_modules/
.remotion/
dist/
build/

# XDX Studio local asset cache, runtime memory/locks, renders, and large media (NEVER commit caches)
.xdx_cache/
.xdx_memory/
.xdx_locks/
cache/
projects/*/renders/
projects/*/output/
projects/*/audio/*.wav
projects/*/assets/downloaded/
projects/*/scenes/*.blend
*.blend
*.blend1
*.glb
*.hdr
*.exr
*.wav
*.mp4
!tests/fixtures/synthetic.mp4
!reference_database/references/**/*.mp4

# Secrets, tokens, pairing configs, and credentials (STRICTLY FORBIDDEN IN GIT)
.env
.env.*
!.env.example
*secret*
*credentials*
*auth_token*
mcp_config.local.json
antigravity_mcp_config.local.json

# Runtime checkpoint/lock state (Phase 01.6C cleanup, DEF-P016C-019): never commit per-step checkpoints
# or lock files. Only the compact evidence (latest_checkpoint.json, portable_checkpoint_bundle_v4.json) is kept.
projects/*/.checkpoints/checkpoint_*.json
*.state.lock
.checkpoint.lock
