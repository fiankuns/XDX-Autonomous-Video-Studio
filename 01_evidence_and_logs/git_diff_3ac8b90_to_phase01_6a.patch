+    custom_subagent_file: str,
+    implementation_status: str,
+) -> dict[str, Any]:
+    return {
+        "agent_id": agent_id,
+        "agent_number": agent_number,
+        "department": department,
+        "display_name": display_name,
+        "mission": mission,
